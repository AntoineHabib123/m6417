IR = 1..11; %employes reg
IP = 12..24; % employes tmeps plein pas permanent
IE = 25..86; % employes étudiant
I = IR union IP union IE;

IC = 1..4 union 20..23; %les employés qui peuvent etre chef d'equipe
IN = {11} union 23..24 union 75..86; %les employés qui peuvent travailler de nuit
IW = I; %les employés qui peuvent travailler le weekend

horizon = 7; 
J = 1..horizon;
W = 1..(horizon div 7); 

JL = {j | j in J where j mod 7 == 1}; %essemble des Lundi
JW = {j | j in J where j mod 7 == 0 \/ j mod 7 == 6}; %essemble des weekend

H = 1..96;

debut_int = [0,14,16,23,24,28,32,16];
duree_int = [16,16,16,16,16,16,16,24];
fin_int = [debut_int[q] + duree_int[q] | q in Q];

Q = {q0_8, q7_8, q8_8, q11_5_8, q12_8, q14_8, q16_8, q8_12}; %les quarts complets
QN = {q0_8}; %quart de nuit
QJ = {q7_8,q8_8,q11_5_8,q12_8,q14_8,q8_12}; %quart de jour
QS = {q16_8}; %quart de soir




C = 
  [ if i == 4 then {1}
    elseif i == 7 then {5}
    else {} endif
  | i in IR ]; 

T_max =
    [80.0 | i in IR] ++
    [80.0 | i in IP] ++
    [40.0 | i in IE];

c_barre =
    [24 | i in IR] ++
    [20 | i in IP] ++
    [10 | i in IE];

patience = 7;

lmd = 15;
%la demande estimée à l'aide du script demande.ipynb pour les jours de semaine
n_h_sem = [
22.50, 22.50, 15.00, 30.00, 15.00, 22.50, 22.50, 0.00, 7.50, 0.00, 37.50, 7.50, 7.50, 7.50, 30.00, 15.00, 22.50, 30.00, 7.50, 0.00, 45.00, 30.00, 30.00, 30.00, 52.50, 82.50, 90.00, 52.50, 90.00, 90.00, 127.50, 150.00, 97.50, 60.00, 82.50, 120.00, 142.50, 112.50, 105.00, 112.50, 105.00, 97.50, 105.00, 120.00, 75.00, 112.50, 105.00, 97.50, 75.00, 60.00, 75.00, 97.50, 75.00, 67.50, 150.00, 52.50, 90.00, 90.00, 75.00, 75.00, 120.00, 135.00, 67.50, 82.50, 97.50, 75.00, 67.50, 97.50, 67.50, 45.00, 60.00, 97.50, 150.00, 150.00, 225.00, 202.50, 195.00, 187.50, 195.00, 210.00, 105.00, 67.50, 97.50, 75.00, 60.00, 30.00, 90.00, 67.50, 22.50, 60.00, 52.50, 60.00, 22.50, 22.50, 0.00, 45.00
];

%la demande estimée à l'aide du script demande.ipynb pour les jours de fin de semaine
n_h_fds = [
45.00, 45.00, 30.00, 15.00, 30.00, 22.50, 30.00, 30.00, 15.00, 15.00, 30.00, 22.50, 7.50, 0.00, 0.00, 7.50, 15.00, 22.50, 15.00, 22.50, 37.50, 30.00, 15.00, 52.50, 67.50, 75.00, 60.00, 67.50, 112.50, 105.00, 195.00, 112.50, 165.00, 67.50, 202.50, 75.00, 150.00, 112.50, 142.50, 142.50, 337.50, 352.50, 315.00, 330.00, 307.50, 292.50, 292.50, 270.00, 330.00, 367.50, 397.50, 367.50, 352.50, 285.00, 322.50, 277.50, 307.50, 315.00, 337.50, 375.00, 255.00, 270.00, 307.50, 247.50, 240.00, 247.50, 202.50, 217.50, 255.00, 127.50, 112.50, 157.50, 97.50, 30.00, 37.50, 75.00, 15.00, 67.50, 52.50, 75.00, 45.00, 52.50, 67.50, 52.50, 7.50, 15.00, 37.50, 30.00, 7.50, 7.50, 0.00, 22.50, 0.00, 0.00, 15.00, 0.00
];

%les bloques de 15 minutes qui composent les quarts
plages_quarts = [
  1..31,
  29..60,
  33..64,
  46..77,
  49..80,
  57..88,
  65..96,
  33..80
];

plages_pause_15 = [ %les pauses de 15 minutes possibles en function des plages de quarts
  7..10  union 23..26,                      % q1
  35..38 union 51..54,                      % q2
  39..42 union 55..58,                      % q3
  52..55 union 68..71,                      % q4
  55..58 union 71..74,                      % q5
  63..66 union 79..82,                      % q6
  71..74 union 87..90,                      % q7
  39..42 union 55..58 union 63..66 union 71..74  % q8 (12h)
];

plages_pause_60 = [ %les pauses midi possibles en fonction des plages de quarts
  13..20,   % q1
  41..48,   % q2
  45..52,   % q3
  58..65,   % q4
  61..68,   % q5
  69..76,   % q6
  77..84,   % q7
  45..52    % q8 (12h)
];

a_hq = %parametre a_hq qui prend en compte si les gens sont en pause et qui indique si le block h appartient au quart q
  array2d(H, Q,
    [
      if not (h in plages_quarts[q]) then
        0.0
      elseif h in plages_pause_60[q] then
        0.5
      elseif h in plages_pause_15[q] then
        0.75
      else
        1.0
      endif
      | h in H, q in Q
    ]
  );

p = %paramètre des préférences
  array3d(I,J,Q,
    [ let {
        int: score_j = %les préférence de jour
          if i in IR \/ i in IP then
            if j in (J diff JW) then 10 else 5 endif %favoriser les jours de semaine pour les employés à temps plein
          else
            if j in JW then 10 else 7 endif %favoriser les weekends pour les étudiants
          endif;

        int: score_q = %les préférence de quart
          if i in IR \/ i in IP then 
            if q in QJ then 10 %grosse préférence pour les quarts de jours pour les employés à temps plein
            elseif q in QS then 8 
            elseif i in IN then 5 
            else 1 
            endif
          else %les étudiants
            if q in QS then 10 %grosse préférence pour les quarts de soir pour les étudiants 
            elseif q in QJ /\ j in JW then 8
            elseif q in QJ /\ j in (J diff JW) then 1
            elseif i in IN then 5 %préférence pour les étudiants qui veullent travailler la nuit
            else 2 %si ne sont dans aucun des groupe
            endif
          endif;
      }
      in score_j + score_q
    | i in I, j in J, q in Q ] );


