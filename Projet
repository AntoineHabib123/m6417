% Employees 1-10: any preferences
constraint forall(i in 1..10, j in J, q in Q)(p_ijq[i,j,q] in 1..10);

% Employee 11: high preference only for first index position (q=1)
constraint forall(j in J)(
    p_ijq[11,j,1] = 10 /\  % first position gets high preference
    forall(q in 2..8)(p_ijq[11,j,q] = 1)  % other positions get low preference
);

% Employees 12-23: any preferences
constraint forall(i in 12..23, j in J, q in Q)(p_ijq[i,j,q] in 1..10);

% Employees 24-85: high preference for last two index positions (q=7,8)
constraint forall(i in 24..85, j in J)(
    p_ijq[i,j,7] >= 8 /\  % second-to-last position
    p_ijq[i,j,8] >= 8 /\  % last position
    forall(q in 1..6)(p_ijq[i,j,q] <= 4)  % other positions get lower preference
);
